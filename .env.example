# Environment variables for IBHAX Django project (Docker)
# Copy this file to .env and fill in your values

# Django settings
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=False

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,ibhax.com,www.ibhax.com

# TinyMCE WYSIWYG Editor API Key
# Get your free key at https://www.tiny.cloud/
TINYMCE_API_KEY=your-tinymce-api-key

# Database path (for Docker, use /app/data/db.sqlite3)
# DB_PATH=/app/data/db.sqlite3

# Media root (for Docker, use /app/media)
# MEDIA_ROOT=/app/media
